{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homecloud-frontend",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-07",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "homecloud-frontend"
    }
  ],
  "env": {
    "production": {
      "name": "homecloud-frontend-prod"
    },
    "staging": {
      "name": "homecloud-frontend-staging"
    }
  }
}
