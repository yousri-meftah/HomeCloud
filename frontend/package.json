    "@types/react-dom": "^18.2.21",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.2.5",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "wrangler": "^4.86.0"
