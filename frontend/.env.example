# HomeCloud Frontend Environment Variables
# Copy to .env.local for development

# API Backend URL (FastAPI)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Cloudflare
NEXT_PUBLIC_CF_DOMAIN=yourdomain.com

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=https://YOUR_SENTRY_DSN

# Google Gemini (optional - if calling directly, otherwise backend proxies)
NEXT_PUBLIC_GEMINI_ENABLED=false
